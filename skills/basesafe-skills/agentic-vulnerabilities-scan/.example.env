# Copy this file outside the skill and fill in only the section for the selected
# target integration. Do not commit the resulting file or put credentials here.

# Required for every scan. Use the approved Promptfoo deployment.
PROMPTFOO_HOST=
PROMPTFOO_API_KEY=

# Optional: a dedicated scan-workspace subdirectory in the target repository.
# Leave unset to use <target-repository>/.agentic-vulnerabilities-scan.
# AGENTIC_SCAN_DIR=.agentic-vulnerabilities-scan

# Interactive scan limits. The preflight defaults to these values when they are
# unset. Raise a limit only after reviewing the displayed scope and obtaining
# explicit approval.
# INTERACTIVE_SCAN_MAX_PLUGINS=2
# INTERACTIVE_SCAN_MAX_STRATEGIES=2
# INTERACTIVE_SCAN_MAX_TESTS_PER_PLUGIN=2
# INTERACTIVE_SCAN_MAX_TOTAL_TESTS=4

# OpenAI-compatible HTTP target only. MODEL_ENDPOINT must be the exact endpoint
# that accepts an OpenAI-style chat-completions POST request.
# MODEL_ENDPOINT=https://staging-api.example.com/v1/chat/completions
# MODEL=openai:chat:your-model
# Leave unset when the endpoint does not require bearer authentication.
# MODEL_AUTH_TOKEN=

# CLI/stdio target only. The command is parsed without a shell and must contain
# the literal {PROMPT} placeholder. Include MODEL_COMMAND in the allowlist below.
# MODEL_COMMAND='your-target --prompt "{PROMPT}"'

# Python or CLI provider only. Comma-separated, present, uppercase variable
# names to persist in provider configuration (for example,
# MODEL_COMMAND,TARGET_API_KEY). Include only variables needed by the target.
# AGENTIC_SCAN_PROVIDER_ENV=MODEL_COMMAND,TARGET_API_KEY

# Headless scans only. Set both values after an interactive scan has established
# the target integration. AGENTIC_SCAN_POLICY points to an approved, read-only
# JSON policy kept outside the target repository.
# AGENTIC_SCAN_HEADLESS=true
# AGENTIC_SCAN_POLICY=/path/to/approved-policy.json

# Do not set PROMPTFOO_DISABLE_REDTEAM_REMOTE_GENERATION=true: this skill
# requires Promptfoo remote red-team generation.
